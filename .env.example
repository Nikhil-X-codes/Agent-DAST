# AgentShield Free-Tier Provider API Keys
# Copy this file to .env and fill in the keys for the free providers you want to use.
# Never commit .env or real API keys to version control.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Strict zero-cost enforcement (true | false)
AGENTSHIELD_ZERO_COST=true

# Optional default provider/model overrides for target agents (groq | gemini | openrouter)
AGENTSHIELD_PROVIDER=
AGENTSHIELD_MODEL=
